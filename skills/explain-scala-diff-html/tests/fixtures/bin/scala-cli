#!/usr/bin/env python3
"""Fake Scala CLI for grid and kernel tests."""
import pathlib
import json
import os
import re
import sys
import time

args = sys.argv[1:]
if args == ["version"]:
    print("Scala CLI version: 1.10.0")
    sys.exit(0)
if "compile" in args and any(arg.endswith("ScalaVersionCheck.scala") for arg in args):
    version = args[args.index("--scala") + 1]
    if os.environ.get("FAKE_SCALA_CLI_UNSUPPORTED") == version:
        print(f"Scala {version} is unsupported by this Scala CLI", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)
if "run" in args:
    source = pathlib.Path(next(arg for arg in args if arg.endswith("Batch.scala"))).read_text()
    output = pathlib.Path(args[-1])
    revision = "head" if "head.jar" in args[args.index("--extra-jars") + 1] else "base"
    started = time.monotonic()
    time.sleep(0.05)
    if "GRID_REJECT" in source and revision == "head":
        print("Compilation failed: fake compiler rejection", file=sys.stderr)
    else:
        with output.open("w") as rows:
            for line in source.splitlines():
                match = re.match(r'^\(("(?:\\.|[^"\\])*"), \(\) =>', line)
                if match:
                    rows.write(json.dumps({"key": json.loads(match.group(1)), "kind": "value",
                                           "render": revision}) + "\n")
    if os.environ.get("FAKE_GRID_LOG"):
        with open(os.environ["FAKE_GRID_LOG"], "a") as log:
            log.write(json.dumps({"revision": revision, "start": started,
                                  "end": time.monotonic(), "rejected": "GRID_REJECT" in source}) + "\n")
    sys.exit(1 if "GRID_REJECT" in source and revision == "head" else 0)
if "compile" not in args:
    print("Unexpected fake scala-cli command", file=sys.stderr)
    sys.exit(2)
source = pathlib.Path("Live.scala").read_text()
output = pathlib.Path(args[args.index("-d") + 1])
if "BAD_COMPILE" in source:
    line = next(i for i, text in enumerate(source.splitlines(), 1) if "BAD_COMPILE" in text)
    print(f"Live.scala:{line}: error: fake compiler rejection", file=sys.stderr)
    sys.exit(1)
if "SLOW_COMPILE" in source:
    time.sleep(30)
output.mkdir(parents=True, exist_ok=True)
(output / "Live.scala").write_text(source)

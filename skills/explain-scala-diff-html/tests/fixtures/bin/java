#!/usr/bin/env python3
"""Fake JVM for kernel HTTP tests."""
import json
import pathlib
import sys
import time

classpath = sys.argv[sys.argv.index("-cp") + 1]
source = (pathlib.Path(classpath.split(":")[0]) / "Live.scala").read_text()
if "SLOW_RUN" in source:
    time.sleep(30)
if "PRINT_HELLO" in source:
    print("hello from fake JVM")
name = "head" if "/head/" in classpath else "base"
kind = "refused" if "throw new Refused" in source and "EFFECT_CALL" in source else "value"
render = "Effects are disabled in this kernel. Restart it with --allow-effects to run cats.effect.IO." if kind == "refused" else name
pathlib.Path(sys.argv[-1]).write_text(json.dumps({"kind": kind, "render": render}))
